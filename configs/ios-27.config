# iOS 27.0.1 (24A446) profile fragment
CONFIG_DARWIN_VERSION="23.6.0"
CONFIG_XNU_VERSION="10063.141.1"
CONFIG_BUILD_ID="24A446"

# Required features
CONFIG_REQUIRE_ARM64E=y
CONFIG_REQUIRE_NATIVE_PAC_KEYS=y
CONFIG_REQUIRE_ARM64E_THREADED_STARTS=y
CONFIG_REQUIRE_NATIVE_4K_PAGES=y
CONFIG_REQUIRE_SOURCE_STORAGE=y
CONFIG_REQUIRE_OFFLINE_OWNER=y
CONFIG_REQUIRE_MOCKFS=y
CONFIG_REQUIRE_UNIONFS=y
CONFIG_REQUIRE_TRUSTCACHE_RUNTIME=y
CONFIG_REQUIRE_PUBLIC_ENTITLEMENTS=y
CONFIG_REQUIRE_AMFI_STUB=y
CONFIG_REQUIRE_SANDBOX_STUB=y

# Boot arguments
CONFIG_BOOTARGS_IOS27="bootcpu=7 cpus=8 cpufreq=1 fb_hz=120 fb_threads=6 touch_poll_us=4000 metal=1 thermal=2 adsp=1 sound=4 battery=1 wifi=1 haptic=5 adreno_stream1=0 small_cores_after=0 touch_no_rpmh=1 ufs=2 ufs_native=1"
